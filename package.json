{
  "name": "raquel-storefront",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/serve-frontend.mjs",
    "dev:api": "npm --prefix backend run dev",
    "check": "node scripts/check-frontend.mjs",
    "test:frontend": "node backend/node_modules/@playwright/test/cli.js test --config=playwright.config.mjs",
    "test:frontend:real": "node backend/node_modules/@playwright/test/cli.js test --config=playwright.live.config.mjs",
    "test:public:real": "node backend/node_modules/@playwright/test/cli.js test --config=playwright.public.config.mjs --workers=1",
    "test:backend": "npm --prefix backend test",
    "test:commerce": "node --test tests/commerce.test.mjs",
    "test:api-client": "node --test tests/api-client.test.mjs",
    "test:static": "node --test tests/static-server.test.mjs"
  }
}
